{
  "$schema": "../../../../schemas/code-map-v1.schema.json",
  "schemaVersion": 1,
  "id": "login-demo",
  "title": "登录流程",
  "description": "带提前返回、缓存、重试与多个落地页的登录流程，演示功能块分层与支线折叠。",
  "sources": {
    "ctl.submit": {
      "file": "src/login-controller.ts",
      "startLine": 6,
      "endLine": 14,
      "anchorText": "export async function onSubmit(form: LoginForm): Promise<LoginResult> {\n  const problem = validateForm(form);\n  if (problem) return showError(problem);\n\n  const result = await authenticate(form.username, form.password);\n  if (!result.ok) return showError(result.reason);\n\n  return routeAfterLogin(result.user);\n}",
      "note": "提交入口：校验 → 认证 → 跳转，任一步失败都提前返回"
    },
    "ctl.validate": {
      "file": "src/login-controller.ts",
      "startLine": 7,
      "endLine": 8,
      "anchorText": "  const problem = validateForm(form);\n  if (problem) return showError(problem);",
      "note": "表单不合法时直接提示错误并返回"
    },
    "ctl.auth": {
      "file": "src/login-controller.ts",
      "startLine": 10,
      "endLine": 11,
      "anchorText": "  const result = await authenticate(form.username, form.password);\n  if (!result.ok) return showError(result.reason);",
      "note": "认证失败时提示原因并返回"
    },
    "ctl.route": {
      "file": "src/login-controller.ts",
      "startLine": 13,
      "endLine": 13,
      "anchorText": "  return routeAfterLogin(result.user);",
      "note": "认证成功后按用户状态决定去哪一页"
    },
    "ctl.error": {
      "file": "src/login-controller.ts",
      "startLine": 16,
      "endLine": 19,
      "anchorText": "function showError(message: string): LoginResult {\n  console.warn(`[login] ${message}`);\n  return { error: message };\n}",
      "note": "统一的错误提示出口"
    },
    "val.username": {
      "file": "src/validate.ts",
      "startLine": 5,
      "endLine": 5,
      "anchorText": "  if (!form.username.trim()) return '请输入用户名';",
      "note": "用户名为空"
    },
    "val.password": {
      "file": "src/validate.ts",
      "startLine": 6,
      "endLine": 6,
      "anchorText": "  if (form.password.length < 8) return '密码至少 8 位';",
      "note": "密码长度不足"
    },
    "val.captcha": {
      "file": "src/validate.ts",
      "startLine": 7,
      "endLine": 7,
      "anchorText": "  if (needsCaptcha(form.username) && !form.captcha) return '请输入验证码';",
      "note": "失败次数多时要求验证码"
    },
    "val.needs": {
      "file": "src/validate.ts",
      "startLine": 13,
      "endLine": 15,
      "anchorText": "function needsCaptcha(username: string): boolean {\n  return (failures.get(username) ?? 0) >= 3;\n}",
      "note": "失败 3 次以上需要验证码"
    },
    "val.ok": {
      "file": "src/validate.ts",
      "startLine": 8,
      "endLine": 8,
      "anchorText": "  return undefined;",
      "note": "全部通过"
    },
    "val.record": {
      "file": "src/validate.ts",
      "startLine": 17,
      "endLine": 19,
      "anchorText": "export function recordFailure(username: string): void {\n  failures.set(username, (failures.get(username) ?? 0) + 1);\n}",
      "note": "记录一次失败，影响下次是否要验证码"
    },
    "auth.cache": {
      "file": "src/auth-service.ts",
      "startLine": 8,
      "endLine": 9,
      "anchorText": "  const cached = tokenCache.get(username);\n  if (cached) return { ok: true, user: await loadProfile(cached) };",
      "note": "有缓存的 token 时跳过登录请求"
    },
    "auth.request": {
      "file": "src/auth-service.ts",
      "startLine": 11,
      "endLine": 15,
      "anchorText": "  const token = await requestToken(username, password);\n  if (typeof token !== 'string') {\n    recordFailure(username);\n    return { ok: false, reason: token.reason };\n  }",
      "note": "请求 token，失败时记录并返回原因"
    },
    "auth.store": {
      "file": "src/auth-service.ts",
      "startLine": 16,
      "endLine": 17,
      "anchorText": "  tokenCache.set(username, token);\n  return { ok: true, user: await loadProfile(token) };",
      "note": "缓存 token 并加载用户资料"
    },
    "auth.profile": {
      "file": "src/auth-service.ts",
      "startLine": 34,
      "endLine": 37,
      "anchorText": "async function loadProfile(token: string): Promise<User> {\n  const response = await fetch('/api/me', { headers: { authorization: `Bearer ${token}` } });\n  return (await response.json()) as User;\n}",
      "note": "用 token 拉取用户资料"
    },
    "req.post": {
      "file": "src/auth-service.ts",
      "startLine": 21,
      "endLine": 25,
      "anchorText": "  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {\n    const response = await fetch('/api/login', {\n      method: 'POST',\n      body: JSON.stringify({ username, password }),\n    });",
      "note": "最多尝试 3 次 POST /api/login"
    },
    "req.ok": {
      "file": "src/auth-service.ts",
      "startLine": 26,
      "endLine": 26,
      "anchorText": "    if (response.ok) return ((await response.json()) as { token: string }).token;",
      "note": "成功拿到 token"
    },
    "req.denied": {
      "file": "src/auth-service.ts",
      "startLine": 27,
      "endLine": 28,
      "anchorText": "    if (response.status === 401) return { reason: '用户名或密码错误' };\n    if (response.status === 423) return { reason: '账号已锁定，请联系管理员' };",
      "note": "401 / 423 不重试，直接返回原因"
    },
    "req.retry": {
      "file": "src/auth-service.ts",
      "startLine": 29,
      "endLine": 29,
      "anchorText": "    await delay(200 * 2 ** attempt);",
      "note": "其他错误指数退避后重试"
    },
    "req.giveup": {
      "file": "src/auth-service.ts",
      "startLine": 31,
      "endLine": 31,
      "anchorText": "  return { reason: '服务暂时不可用，请稍后再试' };",
      "note": "重试用尽，返回服务不可用"
    },
    "route.fn": {
      "file": "src/router.ts",
      "startLine": 3,
      "endLine": 7,
      "anchorText": "export function routeAfterLogin(user: User): LoginResult {\n  if (user.mustChangePassword) return { page: '/account/password' };\n  if (user.firstLogin) return { page: '/onboarding' };\n  return { page: redirectTarget() ?? '/home' };\n}",
      "note": "按用户状态选择落地页"
    },
    "route.password": {
      "file": "src/router.ts",
      "startLine": 4,
      "endLine": 4,
      "anchorText": "  if (user.mustChangePassword) return { page: '/account/password' };",
      "note": "必须改密码"
    },
    "route.onboarding": {
      "file": "src/router.ts",
      "startLine": 5,
      "endLine": 5,
      "anchorText": "  if (user.firstLogin) return { page: '/onboarding' };",
      "note": "首次登录走引导"
    },
    "route.home": {
      "file": "src/router.ts",
      "startLine": 6,
      "endLine": 6,
      "anchorText": "  return { page: redirectTarget() ?? '/home' };",
      "note": "默认去首页或 redirect 指定页"
    },
    "route.redirect": {
      "file": "src/router.ts",
      "startLine": 9,
      "endLine": 12,
      "anchorText": "function redirectTarget(): string | undefined {\n  const target = new URLSearchParams(location.search).get('redirect');\n  return target?.startsWith('/') ? target : undefined;\n}",
      "note": "只接受站内相对路径，防止开放重定向"
    }
  },
  "nodes": [
