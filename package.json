{
  "name": "code-detective",
  "displayName": "代码侦探 🕵️",
  "description": "把 AI 生成的功能地图变成可点击的源码导读：调用关系、源码跳转与相关代码高亮。",
  "version": "0.2.0",
  "publisher": "code-detective-dev",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "code map",
    "walkthrough",
    "code reading",
    "代码导读"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "workspaceContains:.code-detective/maps/*.json",
    "onView:codeDetective.mapView",
    "onCommand:codeDetective.openMap",
    "onCommand:codeDetective.generateMap",
    "onCommand:codeDetective.chooseAiProvider",
    "onChatParticipant:code-detective.detective",
    "onLanguageModelTool:codeDetective_searchSources",
    "onLanguageModelTool:codeDetective_readSource",
    "onLanguageModelTool:codeDetective_createMap"
  ],
  "main": "./dist/extension.cjs",
  "scripts": {
    "dev": "node --require ./scripts/preview-env.cjs ./node_modules/vite/bin/vite.js --config vite.config.ts",
    "build": "node scripts/build.mjs",
    "watch:ext": "node scripts/watch.mjs ext",
    "watch:webview": "node scripts/watch.mjs webview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p examples/bag-demo/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "npm run build && node tests/integration/run.cjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --skip-license --out artifacts/code-detective-0.2.0.vsix",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeDetective",
          "title": "代码侦探",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "codeDetective": [
        {
          "type": "webview",
          "id": "codeDetective.mapView",
          "name": "代码地图",
          "icon": "$(type-hierarchy)",
          "contextualTitle": "代码侦探"
        }
      ]
    },
    "commands": [
      {
        "command": "codeDetective.openMap",
        "title": "打开地图",
        "category": "代码侦探",
        "icon": "$(list-selection)"
      },
      {
        "command": "codeDetective.refreshMaps",
        "title": "重新扫描地图",
        "category": "代码侦探",
        "icon": "$(refresh)"
      },
      {
        "command": "codeDetective.startWalkthrough",
        "title": "开始导读",
        "category": "代码侦探",
        "icon": "$(play)"
      },
      {
        "command": "codeDetective.nextStep",
        "title": "下一步",
        "category": "代码侦探"
      },
      {
        "command": "codeDetective.previousStep",
        "title": "上一步",
        "category": "代码侦探"
      },
      {
        "command": "codeDetective.stopWalkthrough",
        "title": "停止导读",
        "category": "代码侦探"
      },
      {
        "command": "codeDetective.clearHighlights",
        "title": "清除高亮",
        "category": "代码侦探"
      },
      {
        "command": "codeDetective.toggleHighlights",
        "title": "切换相关代码高亮",
        "category": "代码侦探",
        "icon": "$(eye)"
      },
      {
        "command": "codeDetective.copyAuthoringPrompt",
        "title": "复制 AI 地图生成提示词",
        "category": "代码侦探"
      },
      {
        "command": "codeDetective.openHelp",
        "title": "查看地图格式与使用说明",
        "category": "代码侦探",
        "icon": "$(question)"
      },
      {
        "command": "codeDetective.generateMap",
        "title": "用 AI 生成地图",
        "category": "代码侦探",
        "icon": "$(sparkle)"
      },
      {
        "command": "codeDetective.chooseAiProvider",
        "title": "选择本地 Agent CLI",
        "category": "代码侦探"
      },
      {
        "command": "codeDetective.cancelAi",
        "title": "取消 AI 任务",
        "category": "代码侦探"
      }
    ],
    "chatParticipants": [
      {
        "id": "code-detective.detective",
        "name": "detective",
        "fullName": "代码侦探",
        "description": "读源码追踪调用链，生成并打开可点击的代码地图",
        "isSticky": true,
        "commands": [
          {
            "name": "map",
            "description": "分析调用流程并生成代码地图",
            "sampleRequest": "从点击背包按钮到刷新物品列表的完整流程"
          },
          {
            "name": "open",
            "description": "打开已生成的代码地图"
          },
          {
            "name": "next",
            "description": "导读下一步"
          },
          {
            "name": "help",
            "description": "查看用法"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "codeDetective_searchSources",
        "tags": [
          "code-detective",
          "search"
        ],
        "displayName": "代码侦探：搜索源码",
        "userDescription": "在工作区源码中按关键字搜索并返回文件与行号",
        "modelDescription": "在工作区源码中按关键字或正则搜索，返回 file、line 与整行文本。用于定位入口函数与调用点。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codeDetectiveSearch",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "要查找的文本，默认按子串匹配"
            },
            "regex": {
              "type": "boolean",
              "description": "是否按正则匹配"
            },
            "caseSensitive": {
              "type": "boolean",
              "description": "是否区分大小写"
            },
            "glob": {
              "type": "string",
              "description": "可选的额外文件过滤，例如 src/**/*.ts"
            },
            "maxResults": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "description": "最多返回多少条匹配"
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "codeDetective_readSource",
        "tags": [
          "code-detective",
          "read"
        ],
        "displayName": "代码侦探：读取源码片段",
        "userDescription": "读取工作区文件指定行范围，输出带行号的文本",
        "modelDescription": "读取工作区文件的指定行范围，输出带行号的文本。行号必须以此处的编号为准。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codeDetectiveRead",
        "inputSchema": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "工作区相对路径，使用 / 分隔"
            },
            "startLine": {
              "type": "integer",
              "minimum": 1,
              "description": "起始行，默认 1"
            },
            "endLine": {
              "type": "integer",
              "minimum": 1,
              "description": "结束行（含），默认 startLine + 199"
            }
          },
          "required": [
            "file"
          ]
        }
      },
      {
        "name": "codeDetective_createMap",
        "tags": [
          "code-detective",
          "map"
        ],
        "displayName": "代码侦探：生成代码地图",
        "userDescription": "把结构化调用流程写成地图文件并在面板中打开",
        "modelDescription": "把探索得到的调用流程写成代码地图。只需给出 sources 的 file/startLine/endLine，插件会按真实文件补全 anchorText、校验并打开地图。节点与连线必须引用真实源码位置。",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codeDetectiveCreateMap",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "sources",
            "nodes",
            "edges"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "kebab-case 地图 id，可省略"
            },
            "title": {
              "type": "string",
              "description": "地图标题，不超过 200 字"
            },
            "description": {
              "type": "string",
              "description": "可选说明"
            },
            "sources": {
              "type": "object",
              "description": "源码位置表，键为 sourceId",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "startLine",
                  "endLine"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "工作区相对路径，使用 / 分隔"
                  },
                  "startLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "sourceIds"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "step",
                      "function",
                      "condition",
                      "event"
                    ]
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "from",
                  "to",
                  "sourceIds"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "call",
                      "flow",
                      "event",
                      "related"
                    ]
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "walkthrough": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "nodeIds",
                  "edgeIds"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "nodeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "edgeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.code-detective/maps/*.json"
        ],
        "url": "./schemas/code-map-v1.schema.json"
      }
    ],
    "configuration": [
      {
        "title": "代码侦探",
        "properties": {
          "codeDetective.ai.agent": {
            "type": "string",
            "default": "claude",
            "enum": [
              "claude",
              "codex"
            ],
            "enumDescriptions": [
              "Claude Code（claude -p）",
              "Codex CLI（codex exec）"
            ],
            "markdownDescription": "用哪个本机 agent CLI 生成地图。agent 会在当前工作区里用只读工具自己阅读源码，插件不发送任何源码文本。新增 agent 见 `codeDetective.ai.cli.agents`。"
          },
          "codeDetective.ai.cli.command": {
            "type": "string",
            "default": "",
            "markdownDescription": "agent 可执行文件路径，留空则用 agent id（`claude` / `codex`）。提示词通过 stdin 传入，不经过 shell。"
          },
          "codeDetective.ai.cli.extraArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "追加到内置参数之后的自定义参数，用于透传 `--model` 等 CLI 选项。"
          },
          "codeDetective.ai.cli.allowedTools": {
            "type": "string",
            "default": "Read,Grep,Glob,LS",
            "markdownDescription": "Claude Code 允许使用的工具列表。保持只读，避免 agent 修改工作区源码。"
          },
          "codeDetective.ai.cli.agents": {
            "type": "array",
            "markdownDescription": "自定义 agent：`id` / `label` / `command` / `args`。用于接入 claude、codex 之外的其他 CLI。",
            "items": {
              "type": "object",
              "required": [
                "id",
                "command"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "description": "唯一标识，用于 codeDetective.ai.agent"
                },
                "label": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                }
              }
            }
          },
          "codeDetective.ai.timeoutMs": {
            "type": "number",
            "default": 300000,
            "minimum": 10000,
            "maximum": 1800000,
            "markdownDescription": "单轮 agent 调用的超时时间（毫秒）。默认 5 分钟，agent 需要读多个文件时请留足时间。"
          }
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeDetective.openMap",
          "when": "view == codeDetective.mapView",
          "group": "navigation@1"
        },
        {
          "command": "codeDetective.generateMap",
          "when": "view == codeDetective.mapView",
          "group": "navigation@2"
        },
        {
          "command": "codeDetective.toggleHighlights",
          "when": "view == codeDetective.mapView",
          "group": "navigation@3"
        },
        {
          "command": "codeDetective.refreshMaps",
          "when": "view == codeDetective.mapView",
          "group": "navigation@4"
        },
        {
          "command": "codeDetective.copyAuthoringPrompt",
          "when": "view == codeDetective.mapView",
          "group": "more@1"
        },
        {
          "command": "codeDetective.chooseAiProvider",
          "when": "view == codeDetective.mapView",
          "group": "more@2"
        },
        {
          "command": "codeDetective.openHelp",
          "when": "view == codeDetective.mapView",
          "group": "more@3"
        }
      ]
    }
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.47.0",
    "ajv": "^8.17.1",
    "elkjs": "^0.11.0",
    "jsonc-parser": "^3.3.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
