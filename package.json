{
  "name": "code-detective-ai",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.1",
  "publisher": "x1phyr",
  "icon": "media/icon.png",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/x1phyr/code-detective.git"
  },
  "bugs": {
    "url": "https://github.com/x1phyr/code-detective/issues"
  },
  "homepage": "https://github.com/x1phyr/code-detective#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "code map",
    "walkthrough",
    "code reading",
    "代码导读"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "workspaceContains:.code-detective/maps/*.json",
    "onView:codeDetective.mapView",
    "onCommand:codeDetective.openMap",
    "onCommand:codeDetective.openMapPanel",
    "onCommand:codeDetective.generateMap",
    "onCommand:codeDetective.generateFromCursor",
    "onCommand:codeDetective.chooseAiProvider",
    "onChatParticipant:code-detective.detective",
    "onLanguageModelTool:codeDetective_searchSources",
    "onLanguageModelTool:codeDetective_readSource",
    "onLanguageModelTool:codeDetective_createMap"
  ],
  "main": "./dist/extension.cjs",
  "scripts": {
    "dev": "node --require ./scripts/preview-env.cjs ./node_modules/vite/bin/vite.js --config vite.config.ts",
    "build": "node scripts/build.mjs",
    "watch:ext": "node scripts/watch.mjs ext",
    "watch:webview": "node scripts/watch.mjs webview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p examples/bag-demo/tsconfig.json && tsc --noEmit -p examples/login-demo/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "npm run build && node tests/integration/run.cjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "vsce package --no-dependencies --githubBranch main --out artifacts/",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "colors": [
      {
        "id": "codeDetective.focusBorder",
        "description": "%colors.focusBorder%",
        "defaults": { "dark": "#e8b923", "light": "#d4a000", "highContrast": "#ffd54a", "highContrastLight": "#b38600" }
      },
      {
        "id": "codeDetective.mapBackground",
        "description": "%colors.mapBackground%",
        "defaults": { "dark": "#ffd54a1a", "light": "#fff8d6", "highContrast": "#ffd54a29", "highContrastLight": "#fff8d6" }
      },
      {
        "id": "codeDetective.callBackground",
        "description": "%colors.callBackground%",
        "defaults": { "dark": "#e8b92347", "light": "#ffe066", "highContrast": "#ffd54a66", "highContrastLight": "#ffd633" }
      },
      {
        "id": "codeDetective.mapBorder",
        "description": "%colors.mapBorder%",
        "defaults": { "dark": "#e8b92366", "light": "#e6c75a", "highContrast": "#ffd54a99", "highContrastLight": "#c9a227" }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeDetective",
          "title": "%viewsContainers.activitybar.0.title%",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "codeDetective": [
        {
          "type": "webview",
          "id": "codeDetective.mapView",
          "name": "%views.codeDetective.0.name%",
          "icon": "$(type-hierarchy)",
          "contextualTitle": "%views.codeDetective.0.contextualTitle%"
        }
      ]
    },
    "commands": [
      {
        "command": "codeDetective.openMap",
        "title": "%command.openMap%",
        "category": "%category%",
        "icon": "$(book)"
      },
      {
        "command": "codeDetective.openMapPanel",
        "title": "%command.openMapPanel%",
        "category": "%category%",
        "icon": "$(link-external)"
      },
      {
        "command": "codeDetective.refreshMaps",
        "title": "%command.refreshMaps%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "codeDetective.startWalkthrough",
        "title": "%command.startWalkthrough%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "codeDetective.nextStep",
        "title": "%command.nextStep%",
        "category": "%category%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codeDetective.previousStep",
        "title": "%command.previousStep%",
        "category": "%category%",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codeDetective.clearHighlights",
        "title": "%command.clearHighlights%",
        "category": "%category%"
      },
      {
        "command": "codeDetective.toggleHighlights",
        "title": "%command.toggleHighlights%",
        "category": "%category%",
        "icon": "$(eye)"
      },
      {
        "command": "codeDetective.highlightsOn",
        "title": "%command.highlightsOn%",
        "category": "%category%",
        "icon": "$(eye)"
      },
      {
        "command": "codeDetective.highlightsOff",
        "title": "%command.highlightsOff%",
        "category": "%category%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "codeDetective.fitView",
        "title": "%command.fitView%",
        "category": "%category%",
        "icon": "$(screen-full)"
      },
      {
        "command": "codeDetective.copyAuthoringPrompt",
        "title": "%command.copyAuthoringPrompt%",
        "category": "%category%"
      },
      {
        "command": "codeDetective.openHelp",
        "title": "%command.openHelp%",
        "category": "%category%",
        "icon": "$(question)"
      },
      {
        "command": "codeDetective.generateMap",
        "title": "%command.generateMap%",
        "category": "%category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "codeDetective.generateFromCursor",
        "title": "%command.generateFromCursor%",
        "category": "%category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "codeDetective.chooseAiProvider",
        "title": "%command.chooseAiProvider%",
        "category": "%category%"
      },
      {
        "command": "codeDetective.cancelAi",
        "title": "%command.cancelAi%",
        "category": "%category%"
      }
    ],
    "chatParticipants": [
      {
        "id": "code-detective.detective",
        "name": "detective",
        "fullName": "%chatParticipants.0.fullName%",
        "description": "%chatParticipants.0.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "map",
            "description": "%chatParticipants.0.commands.0.description%",
            "sampleRequest": "%chatParticipants.0.commands.0.sampleRequest%"
          },
          {
            "name": "open",
            "description": "%chatParticipants.0.commands.1.description%"
          },
          {
            "name": "next",
            "description": "%chatParticipants.0.commands.2.description%"
          },
          {
            "name": "help",
            "description": "%chatParticipants.0.commands.3.description%"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "codeDetective_searchSources",
        "tags": [
          "code-detective",
          "search"
        ],
        "displayName": "%languageModelTools.0.displayName%",
        "userDescription": "%languageModelTools.0.userDescription%",
        "modelDescription": "%languageModelTools.0.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codeDetectiveSearch",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "%languageModelTools.0.query.description%"
            },
            "regex": {
              "type": "boolean",
              "description": "%languageModelTools.0.regex.description%"
            },
            "caseSensitive": {
              "type": "boolean",
              "description": "%languageModelTools.0.caseSensitive.description%"
            },
            "glob": {
              "type": "string",
              "description": "%languageModelTools.0.glob.description%"
            },
            "maxResults": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "description": "%languageModelTools.0.maxResults.description%"
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "codeDetective_readSource",
        "tags": [
          "code-detective",
          "read"
        ],
        "displayName": "%languageModelTools.1.displayName%",
        "userDescription": "%languageModelTools.1.userDescription%",
        "modelDescription": "%languageModelTools.1.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codeDetectiveRead",
        "inputSchema": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "%languageModelTools.1.file.description%"
            },
            "startLine": {
              "type": "integer",
              "minimum": 1,
              "description": "%languageModelTools.1.startLine.description%"
            },
            "endLine": {
              "type": "integer",
              "minimum": 1,
              "description": "%languageModelTools.1.endLine.description%"
            }
          },
          "required": [
            "file"
          ]
        }
      },
      {
        "name": "codeDetective_createMap",
        "tags": [
          "code-detective",
          "map"
        ],
        "displayName": "%languageModelTools.2.displayName%",
        "userDescription": "%languageModelTools.2.userDescription%",
        "modelDescription": "%languageModelTools.2.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codeDetectiveCreateMap",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "sources",
            "nodes",
            "edges",
            "walkthrough"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "%languageModelTools.2.id.description%"
            },
            "title": {
              "type": "string",
              "description": "%languageModelTools.2.title.description%"
            },
            "description": {
              "type": "string",
              "description": "%languageModelTools.2.description.description%"
            },
            "sources": {
              "type": "object",
              "description": "%languageModelTools.2.sources.description%",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "startLine",
                  "endLine"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "%languageModelTools.2.sources.additionalProperties.file.description%"
                  },
                  "startLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "symbol": {
                    "type": "string",
                    "description": "%languageModelTools.2.sources.symbol.description%"
                  },
                  "variantLabel": {
                    "type": "string",
                    "description": "%languageModelTools.2.sources.variantLabel.description%"
                  },
                  "note": {
                    "type": "string",
                    "description": "%languageModelTools.2.sources.note.description%"
                  }
                }
              }
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "sourceIds"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "step",
                      "function",
                      "condition",
                      "event",
                      "exit"
                    ]
                  },
                  "parent": {
                    "type": "string",
                    "description": "%languageModelTools.2.nodes.parent.description%"
                  },
                  "sourceMode": {
                    "enum": [
                      "slices",
                      "variants"
                    ],
                    "description": "%languageModelTools.2.nodes.sourceMode.description%"
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "from",
                  "to",
                  "sourceIds"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "call",
                      "delegated",
                      "dispatch",
                      "event",
                      "flow",
                      "related"
                    ]
                  },
                  "branch": {
                    "type": "string",
                    "description": "%languageModelTools.2.edges.branch.description%"
                  },
                  "via": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "%languageModelTools.2.edges.via.description%"
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "walkthrough": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "nodeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "edgeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "sourceId": {
                    "type": "string",
                    "description": "%languageModelTools.2.walkthrough.sourceId.description%"
                  },
                  "why": {
                    "type": "string",
                    "description": "%languageModelTools.2.walkthrough.why.description%"
                  },
                  "watch": {
                    "type": "string",
                    "description": "%languageModelTools.2.walkthrough.watch.description%"
                  },
                  "skip": {
                    "type": "string",
                    "description": "%languageModelTools.2.walkthrough.skip.description%"
                  },
                  "example": {
                    "type": "string",
                    "description": "%languageModelTools.2.walkthrough.example.description%"
                  },
                  "aside": {
                    "type": "boolean",
                    "description": "%languageModelTools.2.walkthrough.aside.description%"
                  },
                  "branches": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "%languageModelTools.2.walkthrough.branches.description%"
                  }
                }
              }
            },
            "tour": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "example": {
                  "type": "string",
                  "description": "%languageModelTools.2.tour.example.description%"
                },
                "recap": {
                  "type": "string",
                  "description": "%languageModelTools.2.tour.recap.description%"
                },
                "exercise": {
                  "type": "string",
                  "description": "%languageModelTools.2.tour.exercise.description%"
                }
              }
            }
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.code-detective/maps/*.json"
        ],
        "url": "%schema.codeMap.url%"
      }
    ],
    "configuration": [
      {
        "title": "%configuration.0.title%",
        "properties": {
          "codeDetective.ai.agent": {
            "type": "string",
            "default": "copilot",
            "enum": [
              "copilot",
              "agy",
              "codex",
              "claude"
            ],
            "enumDescriptions": [
              "%config.ai.agent.enum.copilot%",
              "%config.ai.agent.enum.agy%",
              "%config.ai.agent.enum.codex%",
              "%config.ai.agent.enum.claude%"
            ],
            "markdownDescription": "%config.ai.agent.markdownDescription%"
          },
          "codeDetective.ai.cli.command": {
            "type": "string",
            "default": "",
            "markdownDescription": "%config.ai.cli.command.markdownDescription%"
          },
          "codeDetective.ai.cli.extraArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.ai.cli.extraArgs.markdownDescription%"
          },
          "codeDetective.ai.cli.allowedTools": {
            "type": "string",
            "default": "",
            "markdownDescription": "%config.ai.cli.allowedTools.markdownDescription%"
          },
          "codeDetective.ai.cli.agents": {
            "type": "array",
            "markdownDescription": "%config.ai.cli.agents.markdownDescription%",
            "items": {
              "type": "object",
              "required": [
                "id",
                "command"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "description": "%config.ai.cli.agents.items.id.description%"
                },
                "label": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                }
              }
            }
          },
          "codeDetective.ai.timeoutMs": {
            "type": "number",
            "default": 300000,
            "minimum": 10000,
            "maximum": 1800000,
            "markdownDescription": "%config.ai.timeoutMs.markdownDescription%"
          }
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeDetective.generateFromCursor",
          "when": "editorTextFocus",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "codeDetective.generateMap",
          "when": "view == codeDetective.mapView",
          "group": "navigation@1"
        },
        {
          "command": "codeDetective.openMapPanel",
          "when": "view == codeDetective.mapView && codeDetective.hasMap",
          "group": "navigation@2"
        },
        {
          "command": "codeDetective.highlightsOn",
          "when": "view == codeDetective.mapView && codeDetective.hasMap && codeDetective.highlightEnabled",
          "group": "navigation@3"
        },
        {
          "command": "codeDetective.highlightsOff",
          "when": "view == codeDetective.mapView && codeDetective.hasMap && !codeDetective.highlightEnabled",
          "group": "navigation@3"
        },
        {
          "command": "codeDetective.openMap",
          "when": "view == codeDetective.mapView",
          "group": "1_maps@1"
        },
        {
          "command": "codeDetective.refreshMaps",
          "when": "view == codeDetective.mapView",
          "group": "1_maps@2"
        },
        {
          "command": "codeDetective.fitView",
          "when": "view == codeDetective.mapView && codeDetective.hasMap",
          "group": "1_maps@3"
        },
        {
          "command": "codeDetective.chooseAiProvider",
          "when": "view == codeDetective.mapView",
          "group": "2_ai@1"
        },
        {
          "command": "codeDetective.copyAuthoringPrompt",
          "when": "view == codeDetective.mapView",
          "group": "2_ai@2"
        },
        {
          "command": "codeDetective.cancelAi",
          "when": "view == codeDetective.mapView",
          "group": "2_ai@3"
        },
        {
          "command": "codeDetective.openHelp",
          "when": "view == codeDetective.mapView",
          "group": "3_help@1"
        }
      ],
      "commandPalette": [
        {
          "command": "codeDetective.highlightsOn",
          "when": "false"
        },
        {
          "command": "codeDetective.highlightsOff",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeDetective.nextStep",
        "key": "alt+]",
        "when": "codeDetective.touring"
      },
      {
        "command": "codeDetective.previousStep",
        "key": "alt+[",
        "when": "codeDetective.touring"
      }
    ]
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.47.0",
    "ajv": "^8.17.1",
    "elkjs": "^0.11.0",
    "jsonc-parser": "^3.3.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.0.0",
    "vite": "^7.0.0"
  }
}
