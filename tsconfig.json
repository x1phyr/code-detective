{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vscode"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "shared/**/*.ts", "webview/**/*.ts", "webview/**/*.vue", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "artifacts", "examples"]
}
