{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行代码侦探（选择文件夹…）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${input:testFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "运行代码侦探（登录示例 · 导读演示）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/examples/login-demo"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "运行代码侦探",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/examples/bag-demo"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "运行代码侦探（当前工作区）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "调试代码侦探（watch）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/examples/bag-demo"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "watch"
    },
    {
      "name": "扩展集成测试",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/tests/integration/index.cjs",
        "--disable-extensions",
        "${workspaceFolder}/examples/bag-demo"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: build"
    }
  ],
  "inputs": [
    {
      "id": "testFolder",
      "type": "promptString",
      "description": "要用代码侦探打开的文件夹，填绝对路径，例如 /Users/you/code/my-project"
    }
  ]
}
