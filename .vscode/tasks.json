{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ],
      "label": "npm: build"
    },
    {
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": [],
      "label": "npm: test"
    },
    {
      "type": "npm",
      "script": "check",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "label": "npm: check"
    },
    {
      "type": "npm",
      "script": "watch:ext",
      "label": "npm: watch:ext",
      "detail": "esbuild 监听扩展宿主",
      "isBackground": true,
      "problemMatcher": {
        "owner": "code-detective-esbuild",
        "pattern": [
          {
            "regexp": "^✘ \\[(ERROR|WARNING)\\] (.+)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s+(\\S+?):(\\d+):(\\d+):$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      }
    },
    {
      "type": "npm",
      "script": "watch:webview",
      "label": "npm: watch:webview",
      "detail": "vite 监听 Webview",
      "isBackground": true,
      "problemMatcher": {
        "owner": "code-detective-vite",
        "pattern": [
          {
            "regexp": "^(/\\S+?|[A-Za-z]:\\\\\\S+?|[\\w./-]+?):(\\d+):(\\d+): (ERROR|WARNING): (.+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^build started\\.\\.\\.$",
          "endsPattern": "^built in \\d+ms\\.$"
        }
      }
    },
    {
      "label": "watch",
      "detail": "并行启动两个 watcher，供调试时热重建",
      "dependsOn": [
        "npm: watch:ext",
        "npm: watch:webview"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
