{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Code Detective Guided Map v1",
  "description": "An AI-authored guided code walkthrough and coarse-grained call map.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "sources", "nodes", "edges", "walkthrough"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": { "$ref": "#/definitions/shortText" },
    "description": { "type": "string" },
    "sources": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": { "$ref": "#/definitions/id" },
      "additionalProperties": { "$ref": "#/definitions/source" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/definitions/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/edge" }
    },
    "walkthrough": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/definitions/step" }
    },
    "tour": { "$ref": "#/definitions/tour" }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2000,
      "items": { "$ref": "#/definitions/id" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "startLine", "endLine"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z][\\w+.-]*:)(?!\\.\\.?(?:/|$))[^\\S\\u0000-\\u001F\\u007F]*[^/\\\\\\s\\u0000-\\u001F\\u007F][^/\\\\\\u0000-\\u001F\\u007F]*(?:/(?!\\.\\.?(?:/|$))[^\\S\\u0000-\\u001F\\u007F]*[^/\\\\\\s\\u0000-\\u001F\\u007F][^/\\\\\\u0000-\\u001F\\u007F]*)*$"
        },
        "startLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "endLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "anchorText": { "type": "string" },
        "symbol": { "$ref": "#/definitions/shortText" },
        "variantLabel": { "$ref": "#/definitions/shortText" },
        "note": { "$ref": "#/definitions/shortText", "description": "One sentence explaining these lines, shown as an inline source annotation." }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/shortText" },
        "description": { "type": "string" },
        "kind": { "enum": ["step", "function", "condition", "event", "exit"] },
        "parent": { "$ref": "#/definitions/id", "description": "Top-level stage node ID; at most one level of grouping." },
        "sourceMode": { "enum": ["slices", "variants"] },
        "sourceIds": { "$ref": "#/definitions/sourceIds" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "from": { "$ref": "#/definitions/id" },
        "to": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/nonEmptyText" },
        "description": { "type": "string" },
        "kind": { "enum": ["call", "delegated", "dispatch", "event", "flow", "related"] },
        "branch": { "$ref": "#/definitions/shortText", "description": "Branch condition; when present, this edge is a collapsed side path. Omit for the main flow." },
        "via": { "$ref": "#/definitions/sourceIds" },
        "sourceIds": { "$ref": "#/definitions/sourceIds" }
      }
    },
    "noteItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "answer"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "question": { "type": "string" },
        "answer": { "$ref": "#/definitions/nonEmptyText" },
        "createdAt": { "type": "string" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "nodeIds", "edgeIds"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/nonEmptyText" },
        "description": { "type": "string" },
        "nodeIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 500,
          "items": { "$ref": "#/definitions/id" }
        },
        "edgeIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1000,
          "items": { "$ref": "#/definitions/id" }
        },
        "sourceId": { "$ref": "#/definitions/id", "description": "Source ID focused by this walkthrough step." },
        "why": { "type": "string", "description": "Why the code is written this way." },
        "watch": { "type": "string", "description": "A detail or pitfall to watch for." },
        "skip": { "type": "string", "description": "Details that may be skipped on the first read." },
        "example": { "type": "string", "description": "What happens to the running example at this step." },
        "aside": { "type": "boolean", "description": "A side-path step, opened inline from a main step through branches." },
        "branches": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": { "$ref": "#/definitions/id" },
          "description": "IDs of aside steps reachable from this step."
        },
        "notes": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/definitions/noteItem" },
          "description": "Notes saved from questions about this step."
        }
      }
    },
    "tour": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "example": { "type": "string", "description": "A running example, such as a user signing in after three failed attempts." },
        "recap": { "type": "string", "description": "A recap after completing the walkthrough." },
        "exercise": { "type": "string", "description": "A short exercise to check understanding." }
      }
    }
  }
}
