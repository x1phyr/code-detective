{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Code Detective map v1",
  "description": "An AI-authored code map. This format describes locations and presentation, not verified program semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "sources", "nodes", "edges"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": { "$ref": "#/definitions/shortText" },
    "description": { "type": "string" },
    "sources": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": { "$ref": "#/definitions/id" },
      "additionalProperties": { "$ref": "#/definitions/source" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/definitions/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/edge" }
    },
    "walkthrough": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2000,
      "items": { "$ref": "#/definitions/id" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "startLine", "endLine"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z][\\w+.-]*:)(?!\\.\\.?(?:/|$))[^\\S\\u0000-\\u001F\\u007F]*[^/\\\\\\s\\u0000-\\u001F\\u007F][^/\\\\\\u0000-\\u001F\\u007F]*(?:/(?!\\.\\.?(?:/|$))[^\\S\\u0000-\\u001F\\u007F]*[^/\\\\\\s\\u0000-\\u001F\\u007F][^/\\\\\\u0000-\\u001F\\u007F]*)*$"
        },
        "startLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "endLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "anchorText": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/shortText" },
        "description": { "type": "string" },
        "kind": { "enum": ["step", "function", "condition", "event"] },
        "sourceIds": { "$ref": "#/definitions/sourceIds" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "from": { "$ref": "#/definitions/id" },
        "to": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/nonEmptyText" },
        "description": { "type": "string" },
        "kind": { "enum": ["call", "flow", "event", "related"] },
        "sourceIds": { "$ref": "#/definitions/sourceIds" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "nodeIds", "edgeIds"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/nonEmptyText" },
        "description": { "type": "string" },
        "nodeIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 500,
          "items": { "$ref": "#/definitions/id" }
        },
        "edgeIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1000,
          "items": { "$ref": "#/definitions/id" }
        }
      },
      "anyOf": [
        { "properties": { "nodeIds": { "type": "array", "minItems": 1 } } },
        { "properties": { "edgeIds": { "type": "array", "minItems": 1 } } }
      ]
    }
  }
}
